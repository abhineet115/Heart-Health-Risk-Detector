rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure user health records under artifacts path
    match /artifacts/{appId}/users/{userId}/healthRecords/{recordId} {
      // 1. Read: Only allow if authenticated user is reading their own records
      allow read: if request.auth != null && request.auth.uid == userId;

      // 2. Create: Authenticated user creating their own records with valid fields
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['score', 'level', 'age', 'gender'])
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0 
                    && request.resource.data.score <= 60
                    && request.resource.data.age is number
                    && request.resource.data.age >= 1 
                    && request.resource.data.age <= 120;

      // 3. Update: User can only modify their own records
      allow update: if request.auth != null && request.auth.uid == userId;

      // 4. Delete: User can only delete their own records
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Direct user documents (if profile/user doc is created)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
